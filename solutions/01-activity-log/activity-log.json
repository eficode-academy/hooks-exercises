    "userPromptSubmitted": [{"type":"command","bash":"bash scripts/01-activity-log/log.sh userPromptSubmitted","powershell":"pwsh -NoProfile -File scripts/01-activity-log/log.ps1 userPromptSubmitted","timeoutSec":5}],
    "preToolUse": [{"type":"command","bash":"bash scripts/01-activity-log/log.sh preToolUse","powershell":"pwsh -NoProfile -File scripts/01-activity-log/log.ps1 preToolUse","timeoutSec":5}],
    "postToolUse": [{"type":"command","bash":"bash scripts/01-activity-log/log.sh postToolUse","powershell":"pwsh -NoProfile -File scripts/01-activity-log/log.ps1 postToolUse","timeoutSec":5}],
    "postToolUseFailure": [{"type":"command","bash":"bash scripts/01-activity-log/log.sh postToolUseFailure","powershell":"pwsh -NoProfile -File scripts/01-activity-log/log.ps1 postToolUseFailure","timeoutSec":5}],
    "errorOccurred": [{"type":"command","bash":"bash scripts/01-activity-log/log.sh errorOccurred","powershell":"pwsh -NoProfile -File scripts/01-activity-log/log.ps1 errorOccurred","timeoutSec":5}],
    "preCompact": [{"type":"command","bash":"bash scripts/01-activity-log/log.sh preCompact","powershell":"pwsh -NoProfile -File scripts/01-activity-log/log.ps1 preCompact","timeoutSec":5}],
