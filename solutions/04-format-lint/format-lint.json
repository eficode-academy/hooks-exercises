{
  "version": 1,
  "hooks": {
    "postToolUse": [
      {
        "type": "command",
        "bash": "bash scripts/04-format-lint/after-edit.sh",
        "powershell": "pwsh -NoProfile -File scripts/04-format-lint/after-edit.ps1",
        "matcher": "edit|create|apply_patch",
        "timeoutSec": 30
      }
    ]
  }
}
