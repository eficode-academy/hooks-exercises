{
  "version": 1,
  "hooks": {
    "postToolUseFailure": [
      {
        "type": "command",
        "bash": "bash scripts/06-failure-recovery/recover.sh",
        "powershell": "pwsh -NoProfile -File scripts/06-failure-recovery/recover.ps1",
        "env": {
          "HOOK_LOG_DIR": ".hooks-state"
        },
        "timeoutSec": 5
      }
    ]
  }
}
