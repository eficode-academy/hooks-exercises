    "postToolUse": [{"type":"command","bash":"bash scripts/06-failure-recovery/recover.sh postToolUse","powershell":"pwsh -NoProfile -File scripts/06-failure-recovery/recover.ps1 postToolUse","timeoutSec":5}],
